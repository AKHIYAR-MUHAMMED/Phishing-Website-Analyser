# Copy this file to .env and fill in what you have. Never commit .env (it is already in
# .gitignore). config.py loads it automatically via python-dotenv if present; every variable
# below also has a safe default, so nothing here is required to run the app.

# --- LLM API keys (each is optional; engines without a key report status "unavailable") ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5-preview

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-4-opus-20260301

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# --- Crawler safety limits (crawler/fetcher.py) ---
CRAWLER_TIMEOUT_SECONDS=8.0
CRAWLER_MAX_REDIRECTS=5
CRAWLER_MAX_CONTENT_BYTES=2000000
CRAWLER_USER_AGENT=PhishGuardResearchCrawler/0.1 (+academic project; GET requests only, no form submission)

# --- Reproducibility ---
RANDOM_SEED=42

# --- Database ---
DATABASE_URL=sqlite:///phishguard_x.db

# --- Phase 3 dataset collection (dataset/*.py; see PHASE3_DATASET_PLAN.md) ---
DATASET_CRAWL_CONCURRENCY=5
DATASET_CRAWL_HOST_DELAY_SECONDS=2.0
DATASET_TLS_PROBE_TIMEOUT_SECONDS=5.0
# Optional. Anonymous PhishTank access works without this (rate-limited); add it later with no
# other change. Never commit a real value here or in any generated dataset artifact.
PHISHTANK_APP_KEY=

# --- Legacy synthetic dataset generator (dataset_loader.py) ---
# Not used by the real scan pipeline. Leave empty unless you specifically need to regenerate
# the old synthetic CSV from a local Kaggle cache file (see CLAUDE.md section 6 and 13).
PHISHGUARD_KAGGLE_CACHE_CSV=
